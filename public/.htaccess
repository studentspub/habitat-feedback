# Nur Apache (Container); der WSL-Dev-Server `php -S` ignoriert diese Datei.
# Issue #13 (Karten-Performance).

# JSON/GeoJSON komprimieren — Debians deflate.conf deckt nur HTML/CSS/JS ab.
# Die Grenzdatei schrumpft so von 322 auf ~107 KB, API-Antworten auf ein Drittel.
# Achtung: AddOutputFilterByType hier ERSETZT die Liste aus deflate.conf statt
# sie zu ergänzen — deshalb stehen HTML/CSS/JS noch einmal mit drin.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript
    AddOutputFilterByType DEFLATE application/json application/geo+json image/svg+xml
</IfModule>

# Statische Dateien lange cachen. map.js/map.css werden über ?v=<Änderungszeit>
# eingebunden, eine neue Version hat also automatisch eine neue URL.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|geojson|png|svg)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
