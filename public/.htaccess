# Nur Apache (Container, später ggf. Strato); der WSL-Dev-Server `php -S`
# ignoriert diese Datei. Issue #13 (Karten-Performance), Routing für Strato (#16).

# Alle Pfade, die keine echte Datei sind (/bewerten, /api/…), gehen an index.php.
# Im Container steht dasselbe in der Apache-Site; auf Strato gibt es nur diese
# Datei — ohne die Zeile lieferte dort jede Seite außer / einen 404.
FallbackResource /index.php

# HTTPS erzwingen (Issue #38) – nur für die Live-Domain, der Test-Container im Heimnetz läuft über http.
# Außerdem den Authorization-Header (Bearer-Token des Geocode-Workers, /api/pi/…) an PHP-FastCGI durchreichen:
# Apache verwirft ihn für CGI/FastCGI sonst (Issue #39: 401 auf Strato); Auth.php liest HTTP_AUTHORIZATION
# oder REDIRECT_HTTP_AUTHORIZATION. (CGIPassAuth wäre sauberer, braucht aber AllowOverride AuthConfig.)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} ^(www\.)?habitat-feedback\.de$ [NC]
    RewriteRule ^ https://habitat-feedback.de%{REQUEST_URI} [R=301,L]
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# JSON/GeoJSON komprimieren — Debians deflate.conf deckt nur HTML/CSS/JS ab.
# Die Grenzdatei schrumpft so von 322 auf ~107 KB, API-Antworten auf ein Drittel.
# Achtung: AddOutputFilterByType hier ERSETZT die Liste aus deflate.conf statt
# sie zu ergänzen — deshalb stehen HTML/CSS/JS noch einmal mit drin.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript
    AddOutputFilterByType DEFLATE application/json application/geo+json image/svg+xml
</IfModule>

# Statische Dateien lange cachen. map.js/map.css werden über ?v=<Änderungszeit>
# eingebunden, eine neue Version hat also automatisch eine neue URL.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|geojson|png|svg)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    # PHP-Version nicht verraten (Stratos FastCGI setzt den Header, #35)
    Header unset X-Powered-By
    Header always unset X-Powered-By
    # HSTS nur über HTTPS; erst eine Woche, nach dem ersten Monat auf 31536000 erhöhen (#38)
    Header always set Strict-Transport-Security "max-age=604800" env=HTTPS
</IfModule>
